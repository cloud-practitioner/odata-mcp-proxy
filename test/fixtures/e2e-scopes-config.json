{
  "server": {
    "name": "scopes-e2e",
    "version": "0.0.1",
    "description": "Stub config shaped like ci-mcp-server's ci-api-config.json: every enabled operation carries a requiredScope"
  },
  "discovery": {
    "mode": "hybrid",
    "alwaysRegister": ["IntegrationPackages"]
  },
  "apis": [
    {
      "name": "cpi",
      "destination": "E2E_SCOPES_DEST",
      "pathPrefix": "/api/v1",
      "entitySets": [
        {
          "entitySet": "IntegrationPackages",
          "description": "Integration packages",
          "category": "integration-content",
          "keys": [{ "name": "Id", "type": "string" }],
          "operations": {
            "list": { "enabled": true, "requiredScope": "read" },
            "get": { "enabled": true, "requiredScope": "read" },
            "create": { "enabled": true, "requiredScope": "write" },
            "update": { "enabled": true, "requiredScope": "write" },
            "delete": { "enabled": true, "requiredScope": "admin" }
          },
          "navigationProperties": [
            { "name": "IntegrationDesigntimeArtifacts", "description": "Design-time artifacts of the package", "isCollection": true }
          ]
        },
        {
          "entitySet": "MessageProcessingLogs",
          "description": "Message processing logs",
          "category": "message-processing-logs",
          "keys": [{ "name": "MessageGuid", "type": "string" }],
          "operations": {
            "list": { "enabled": true, "requiredScope": "read" },
            "get": { "enabled": true, "requiredScope": "read" },
            "create": false,
            "update": false,
            "delete": { "enabled": false, "requiredScope": "admin" }
          }
        }
      ]
    }
  ]
}
